HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Local development uses SQLite. Change DATABASE_CLIENT to postgres on the server.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# PostgreSQL settings for the future server migration.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=flydeer_news
DATABASE_USERNAME=flydeer_news
DATABASE_PASSWORD=change-me
DATABASE_SCHEMA=public
DATABASE_SSL=false

# Chinese is the first authoring locale. English can be added in Settings > Internationalization.
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=zh

# Comma-separated front-end origins allowed to read the local API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
UPLOAD_SIZE_LIMIT=10485760
